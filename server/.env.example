# Copy to server/.env and edit. Every value has a default; only set what you change.

# 1 = serve docs/contracts/examples/*.json (no broker / DB needed)
SINAG_MOCK=0

MQTT_HOST=localhost
MQTT_PORT=1883

# Local LLM via Ollama's OpenAI-compatible endpoint.
LLM_ENABLED=1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama
LLM_TIMEOUT_S=20
# Cloud fallback: point LLM_BASE_URL / LLM_MODEL / LLM_API_KEY at any OpenAI-compatible provider.

DEFAULT_RATE=13.0
DEFAULT_BATTERY_KWH=10.0
DEFAULT_USER_NAME=Juan
DEFAULT_DEVICE_ID=sinag-001
