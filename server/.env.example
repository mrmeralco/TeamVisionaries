# Copy to server/.env and edit. Every value has a default; only set what you change.

# 1 = serve docs/contracts/examples/*.json (no broker / DB needed)
SINAG_MOCK=0

MQTT_HOST=localhost
MQTT_PORT=1883

# Local LLM: Qwen 3.5 on Ollama (see server/ai/README.md for picking a size).
LLM_ENABLED=1
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
LLM_TIMEOUT_S=20
CHAT_BUDGET_S=25
LLM_KEEP_ALIVE=60m

# Cloud fallback (only if the laptop is too slow): any OpenAI-compatible API.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://<provider>/v1
# LLM_MODEL=<model>
# LLM_API_KEY=<key>

# Meralco overall rate for a 200 kWh household (Oct 2026); update monthly
DEFAULT_RATE=15.06
DEFAULT_BATTERY_KWH=10.0
DEFAULT_USER_NAME=Juan
DEFAULT_DEVICE_ID=sinag-001

# Solar + battery outlook (GET /api/outlook). Weather comes from Open-Meteo (free, no key); only these
# coordinates are sent. Defaults to Metro Manila. WEATHER_ENABLED=0 -> outlook uses history only.
WEATHER_ENABLED=1
SITE_LAT=14.5995
SITE_LON=120.9842
# panel size, used until a week of history is there to calibrate
PV_KWP=5.0
# inverter stops using the battery here while the grid is on
BATT_RESERVE_PCT=20
# inverter shuts down here in a brownout
BATT_CUTOFF_PCT=5
# max charge/discharge power
BATT_MAX_KW=3.0
